# Скопировать в .env.local (для локального запуска) и в Vercel -> Settings -> Environment Variables

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=ваш_service_role_key

# Любая случайная длинная строка (для подписи сессии входа), придумайте сами
APP_SECRET=придумайте-любую-длинную-случайную-строку
